    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
